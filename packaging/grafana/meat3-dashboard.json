     "expr": "meat3_temperature_celsius{instance=~\"$instance\",id=~`nv\\d+\\.t\\.(gpu|hotspot|mem)|amdgpu\\d+\\.gm\\.temperature_(edge|hotspot|mem)`}",
     "legendFormat": "{{instance}} {{sensor}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "celsius",
