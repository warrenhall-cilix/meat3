+/*
+ * Board CustomSkuTable override (the table Windows tools send as a "SoftTuningTable"): power,
+ * TDC, temperature and fan limits. The PMFW validates it against the signed board limits and
+ * reports rejected sections in the response argument (TABLE_PPT_FAILED, TABLE_TDC_FAILED, ...).
+ * Read from firmware file amdgpu/custom_sku_<pci address>.bin, exactly sizeof(CustomSkuTable_t).
+ */
+static int smu_v14_0_2_upload_custom_sku(struct smu_context *smu, bool verbose)
+{
+	struct amdgpu_device *adev = smu->adev;
+	const struct firmware *fw;
+	uint32_t resp = 0;
+	char name[64];
+	int ret;
+
+	snprintf(name, sizeof(name), "amdgpu/custom_sku_%s.bin", pci_name(adev->pdev));
+	ret = firmware_request_nowarn(&fw, name, adev->dev);
+	if (ret) {
+		if (verbose)
+			dev_info(adev->dev, "custom SKU table: %s not found\n", name);
+		return verbose ? -ENOENT : 0;
+	}
+	if (fw->size != sizeof(CustomSkuTable_t)) {
+		dev_warn(adev->dev, "custom SKU table: %s is %zu bytes, expected %zu; ignored\n",
+			 name, fw->size, sizeof(CustomSkuTable_t));
+		release_firmware(fw);
+		return verbose ? -EINVAL : 0;
+	}
+	ret = smu_cmn_update_table_read_arg(smu, SMU_TABLE_CUSTOM_SKUTABLE, 0,
+					    (void *)fw->data, &resp, true);
+	release_firmware(fw);
+	if (ret)
+		dev_warn(adev->dev, "custom SKU table: PMFW rejected the transfer (%d, response 0x%x)\n",
+			 ret, resp);
+	else
+		dev_info(adev->dev, "custom SKU table: %s uploaded, PMFW response 0x%x%s%s%s%s\n", name, resp,
+			 resp & TABLE_PPT_FAILED ? " PPT-rejected" : "",
+			 resp & TABLE_TDC_FAILED ? " TDC-rejected" : "",
+			 resp & TABLE_TEMP_FAILED ? " TEMP-rejected" : "",
+			 resp & 0x3F800 ? " FAN-rejected" : "");
+	return verbose ? ret : 0;
+}
+
