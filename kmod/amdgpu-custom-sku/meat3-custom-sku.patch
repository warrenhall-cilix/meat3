+static ssize_t smu_custom_sku_write(struct file *f, const char __user *buf,
+				    size_t size, loff_t *pos)
+{
+	struct amdgpu_device *adev = file_inode(f)->i_private;
+	struct smu_context *smu = adev->powerplay.pp_handle;
+	int ret;
+
+	/* any write re-reads amdgpu/custom_sku_<pci>.bin and sends it again */
+	mutex_lock(&adev->pm.mutex);
+	ret = smu->ppt_funcs->upload_custom_sku(smu, true);
+	mutex_unlock(&adev->pm.mutex);
+	return ret ? ret : size;
+}
